MFLOW_API_KEY=replace-me
MFLOW_BASE_URL=https://api.deepseek.com
MFLOW_MODEL=deepseek-flash
# Optional OpenAI-compatible request options, frozen in new MFlow bundles:
# MFLOW_PROVIDER_OPTIONS={"chat_template_kwargs":{"enable_thinking":false}}
# MFLOW_BASELINE_PROTOCOL=configs/hb-baselines.json
BENCHMARK_HOME=../Benchmarks
MFLOW_BENCH_PYTHON=../Benchmarks/environments/text/bin/python
MFLOW_EVALPLUS_IMAGE=mflow-evalplus:0.1.10
MFLOW_PYTHON_IMAGE=python:3.12-alpine
# Required for HLE evaluation; choose a judge supported by MFLOW_BASE_URL.
# The official pinned HLE evaluator uses o3-mini-2025-01-31; using another judge must be reported.
# MFLOW_HLE_JUDGE_MODEL=deepseek-flash
# Optional override; defaults to the official locked AutomationBench .venv:
# MFLOW_AUTOMATION_PYTHON=../Benchmarks/collections/automationbench/official/.venv/bin/python
# Optional HLE view: official text test (default), full official test, or custom search/test holdout.
# MFLOW_HLE_PROTOCOL=hle-full-holdout-v1
