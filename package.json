{
  "name": "mflow-spawn-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Execution-grounded organization strategy search using the published Ditto package",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "mflow": "node --env-file-if-exists=.env dist/src/cli.js"
  },
  "dependencies": {
    "@codesoul-co/ditto": "0.1.1",
    "undici": "7.30.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  }
}
